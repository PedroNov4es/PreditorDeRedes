# Copie para .env e ajuste. Variáveis EXPO_PUBLIC_* são lidas pelo app.
# Emulador Android:  http://10.0.2.2:8080
# Simulador iOS:     http://localhost:8080
# Celular físico:    http://IP-DA-SUA-MAQUINA:8080  (mesma rede Wi-Fi)
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080
EXPO_PUBLIC_MODEL_ID=model-a
# true = usa dados simulados locais (sem API)
EXPO_PUBLIC_USE_MOCK=false
